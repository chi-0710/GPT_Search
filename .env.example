# ResearchRunner: copy to .env only on first setup. Never commit credentials.
POSTGRES_DB=gpt_researcher
POSTGRES_USER=gpt_researcher
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=5
FRONTEND_PORT=3800
NEXT_PUBLIC_GPTR_API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
FAST_LLM=deepseek:deepseek-v4-flash
SMART_LLM=deepseek:deepseek-v4-flash
STRATEGIC_LLM=deepseek:deepseek-v4-flash
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING=dashscope:text-embedding-v4
EMBEDDING_DIMENSION=1536
TAVILY_API_KEY=
MAX_BLOB_SIZE_MB=50
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=100
DOCUMENT_RETRIEVAL_LIMIT=8
DOCUMENT_SIMILARITY_THRESHOLD=0.35
JAVA_SECTION_REVIEW_TOKEN_LIMIT=16000
JAVA_FACT_CHECK_TOKEN_LIMIT=16000
IMAGE_GENERATION_ENABLED=false
# Unused optional services
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_API_KEY=
LANGCHAIN_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
