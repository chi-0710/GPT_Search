{
  "schema_version": 1,
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "handler": "read_root"
    },
    {
      "method": "GET",
      "path": "/.well-known/agent-discovery.json",
      "handler": "agent_discovery"
    },
    {
      "method": "GET",
      "path": "/report/{research_id}",
      "handler": "read_report"
    },
    {
      "method": "GET",
      "path": "/health/ready",
      "handler": "health_ready"
    },
    {
      "method": "GET",
      "path": "/api/artifacts/{artifact_id}",
      "handler": "get_artifact"
    },
    {
      "method": "GET",
      "path": "/outputs/{legacy_path:path}",
      "handler": "get_legacy_artifact"
    },
    {
      "method": "GET",
      "path": "/api/reports",
      "handler": "get_all_reports"
    },
    {
      "method": "GET",
      "path": "/api/reports/{research_id}",
      "handler": "get_report_by_id"
    },
    {
      "method": "POST",
      "path": "/api/reports",
      "handler": "create_or_update_report"
    },
    {
      "method": "PUT",
      "path": "/api/reports/{research_id}",
      "handler": "update_report"
    },
    {
      "method": "DELETE",
      "path": "/api/reports",
      "handler": "clear_reports"
    },
    {
      "method": "DELETE",
      "path": "/api/reports/{research_id}",
      "handler": "delete_report"
    },
    {
      "method": "GET",
      "path": "/api/reports/{research_id}/chat",
      "handler": "get_report_chat"
    },
    {
      "method": "POST",
      "path": "/api/reports/{research_id}/chat",
      "handler": "add_report_chat_message"
    },
    {
      "method": "GET",
      "path": "/api/research-runs/{run_id}",
      "handler": "get_research_run"
    },
    {
      "method": "GET",
      "path": "/api/research-runs/{run_id}/events",
      "handler": "get_research_events"
    },
    {
      "method": "GET",
      "path": "/api/research-runs/{run_id}/log",
      "handler": "download_research_log"
    },
    {
      "method": "POST",
      "path": "/report/",
      "handler": "generate_report"
    },
    {
      "method": "GET",
      "path": "/files/",
      "handler": "list_files"
    },
    {
      "method": "GET",
      "path": "/api/documents",
      "handler": "list_documents"
    },
    {
      "method": "GET",
      "path": "/api/documents/{document_id}/content",
      "handler": "document_content"
    },
    {
      "method": "GET",
      "path": "/api/reports/{identifier}/evidence",
      "handler": "evidence_list"
    },
    {
      "method": "GET",
      "path": "/api/research-runs/{identifier}/evidence",
      "handler": "evidence_list"
    },
    {
      "method": "GET",
      "path": "/api/research-runs/{identifier}/evidence/{number}",
      "handler": "evidence_item"
    },
    {
      "method": "GET",
      "path": "/api/research-runs/{identifier}/evidence/{number}/view",
      "handler": "evidence_view"
    },
    {
      "method": "POST",
      "path": "/api/documents",
      "handler": "upload_document"
    },
    {
      "method": "DELETE",
      "path": "/api/documents/{document_id}",
      "handler": "delete_document"
    },
    {
      "method": "POST",
      "path": "/api/documents/{document_id}/reindex",
      "handler": "reindex_document"
    },
    {
      "method": "POST",
      "path": "/api/multi_agents",
      "handler": "run_multi_agents"
    },
    {
      "method": "POST",
      "path": "/upload/",
      "handler": "upload_file"
    },
    {
      "method": "DELETE",
      "path": "/files/{filename}",
      "handler": "delete_file"
    },
    {
      "method": "WEBSOCKET",
      "path": "/ws",
      "handler": "websocket_endpoint"
    },
    {
      "method": "POST",
      "path": "/api/chat",
      "handler": "chat"
    }
  ],
  "chat_providers": [
    "aimlapi",
    "anthropic",
    "atlascloud",
    "avian",
    "azure_openai",
    "bedrock",
    "cohere",
    "dashscope",
    "deepseek",
    "fireworks",
    "forge",
    "gigachat",
    "google_genai",
    "google_vertexai",
