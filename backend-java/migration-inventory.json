    "mistralai",
    "nebius",
    "netmind",
    "ollama",
    "openai",
    "openrouter",
    "together",
    "vllm_openai",
    "xai"
  ],
  "embedding_providers": [
    "aimlapi",
    "azure_openai",
    "bedrock",
    "cohere",
    "custom",
    "dashscope",
    "fireworks",
    "gigachat",
    "google_genai",
    "google_vertexai",
    "huggingface",
    "minimax",
    "mistralai",
    "nebius",
    "netmind",
    "nomic",
    "ollama",
    "openai",
    "openrouter",
    "together",
    "voyageai"
  ],
  "retrievers": [
    "arxiv",
    "bing",
    "bocha",
    "brave",
    "crw",
    "custom",
    "duckduckgo",
    "exa",
    "getxapi",
    "google",
    "groundroute",
    "mcp",
    "openalex",
    "pubmed_central",
    "searchapi",
    "searx",
    "semantic_scholar",
    "serpapi",
    "serper",
    "tavily",
    "xquik"
  ],
  "scrapers": [
    "arxiv",
    "beautiful_soup",
    "browser",
    "firecrawl",
    "pymupdf",
    "tavily_extract",
    "web_base_loader"
  ],
  "document_formats": [
    "csv",
    "doc",
    "docx",
    "htm",
    "html",
    "md",
    "pdf",
    "pptx",
    "txt",
    "xls",
    "xlsx"
  ],
  "configuration_keys": [
    "AGENT_ROLE",
    "BROWSE_CHUNK_MAX_LENGTH",
    "CURATE_SOURCES",
    "DOC_PATH",
    "EMBEDDING",
    "EMBEDDING_KWARGS",
    "FAST_LLM",
    "FAST_TOKEN_LIMIT",
    "IMAGE_GENERATION_ENABLED",
    "IMAGE_GENERATION_MAX_IMAGES",
    "IMAGE_GENERATION_MODEL",
    "IMAGE_GENERATION_PROVIDER",
    "IMAGE_GENERATION_STYLE",
    "LANGUAGE",
    "LLM_KWARGS",
    "MAX_ITERATIONS",
    "MAX_SCRAPER_WORKERS",
    "MAX_SEARCH_RESULTS_PER_QUERY",
    "MAX_SUBTOPICS",
    "MCP_ALLOWED_ROOT_PATHS",
    "MCP_AUTO_TOOL_SELECTION",
    "MCP_SERVERS",
    "MCP_STRATEGY",
    "MEMORY_BACKEND",
    "PROMPT_FAMILY",
    "REASONING_EFFORT",
    "REPORT_FORMAT",
    "REPORT_SOURCE",
    "RETRIEVER",
    "SCRAPER",
    "SCRAPER_RATE_LIMIT_DELAY",
    "SIMILARITY_THRESHOLD",
    "SMART_LLM",
    "SMART_TOKEN_LIMIT",
    "STRATEGIC_LLM",
    "STRATEGIC_TOKEN_LIMIT",
    "SUMMARY_TOKEN_LIMIT",
    "TEMPERATURE",
    "TOTAL_WORDS",
    "USER_AGENT",
    "VERBOSE"
  ],
  "cli_arguments": [
    "--encoding",
    "--no-docx",
    "--no-pdf",
    "--query_domains",
    "--report_source",
    "--report_type",
    "--tone",
    "query"
  ],
  "image_providers": [
    "google",
    "modelslab"
  ],
  "websocket_commands": [
    "ping",
    "start",
    "chat",
    "human_feedback"
  ],
  "mcp_server": "External upstream repository only; no executable server in mcp-server/.",
  "completion_rule": "Inventory presence is not implementation or live verification."
}
